{
  "manifest_version": 3,
  "name": "JobScape Search Prototype",
  "version": "0.1.0",
  "description": "Bring one explicitly requested combined Google ATS search into local JobScape.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.boards.greenhouse.io/*",
    "https://*.job-boards.greenhouse.io/*",
    "https://*.jobs.lever.co/*",
    "https://*.jobs.eu.lever.co/*",
    "https://*.jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.jobs.smartrecruiters.com/*",
    "https://*.apply.workable.com/*",
    "https://*.recruitee.com/*",
    "https://*.jobs.personio.de/*",
    "https://*.jobs.personio.com/*",
    "https://*.icims.com/*",
    "https://*.jobs.jobvite.com/*",
    "https://*.breezy.hr/*",
    "https://*.applytojob.com/*",
    "https://*.taleo.net/*",
    "https://*.bamboohr.com/careers*",
    "https://*.teamtailor.com/jobs*",
    "https://*.recruiting.paylocity.com/*",
    "https://*.workforcenow.adp.com/*",
    "https://*.jobs2web.com/*",
    "https://*.successfactors.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
